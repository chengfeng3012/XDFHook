    <!-- 操作页 -->
    <string name="op_root_title">Root 操作权限</string>
    <string name="op_root_subtitle_off">未授权：开启此开关将请求 root 权限</string>
    <string name="op_root_subtitle_ok">已授权（root 可用）</string>
    <string name="op_root_checking">正在获取 root 权限…</string>
    <string name="op_root_footnote">顶部总开关：开启后先请求并检测 root 权限，拿到后才可用下方按钮；可随时关闭，关闭后即使有 root 下方按钮也全部禁用（防止模块被装进无 root 环境或在根权限管理中被屏蔽）。</string>
    <string name="op_section_function">功能</string>
    <string name="op_section_danger">危险区</string>
    <string name="op_footnote">软重启 = 杀掉 system_server，zygote 派生的全部进程（含全部 app 与桌面）都会随之终止，然后由 zygote 重新拉起系统骨架，真正\"闪一下\"的是系统 UI；硬重启 = 重启整个设备。危险区三项均需二次确认，全部经 shell 以 root 执行。</string>

