# ===== 本地依赖产物（构建产物不入库） =====
app/build/
app/release/

# 本地 SDK 路径等环境相关配置（绝不入库）
local.properties
*.keystore
*.jks

# ===== 本地签名（仓库内目录，内容绝不入库）=====
# keystore/ 里放 xdfhook-release.jks + creds.txt，供本机构建出与 release
# 同签名的包（debug/release 可互相覆盖安装）。仓库只保留目录约定，
# 密钥与口令一律不入库；CI 走 GitHub Secrets 注入环境变量，不依赖这里。
/keystore/
creds.txt

